/* packageAdmin/pages/audit/audit.wxss */
.page { padding: 16rpx 24rpx 60rpx; }

.head-tip { font-size: 24rpx; color: #888; margin: 8rpx 4rpx 20rpx; }

.row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.row-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f0f1f3; flex-shrink: 0; }
.row-main { flex: 1; margin-left: 20rpx; min-width: 0; }
.row-title {
  font-size: 28rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.row-tags { display: flex; margin-top: 10rpx; }
.row-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.time { font-size: 22rpx; color: #b0b3b8; }
.arrow { color: #c8ccd1; font-size: 28rpx; }
