/* pages/login/login.wxss */
.page { padding: 24rpx 24rpx 80rpx; }

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; }
.sub { font-size: 22rpx; color: #9aa0a6; font-weight: 400; margin-left: 12rpx; }

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}
.form-item:last-child { border-bottom: none; }
.label { width: 170rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.required { color: #ff4d2e; }
.optional { font-size: 22rpx; color: #9aa0a6; font-weight: 400; }
.input { flex: 1; font-size: 28rpx; }
.picker-value { flex: 1; font-size: 28rpx; color: #222; }
.picker-value.placeholder { color: #9aa0a6; }

/* 定位自动匹配 */
.locate-btn {
  margin: 20rpx 0 0;
  height: 76rpx;
  border-radius: 12rpx;
  background: #e8f7ef;
  color: #07c160;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #07c160;
}
.locate-btn.locating { color: #9aa0a6; background: #f2f3f5; border-color: #d0d3d8; }
.matched {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: #f0fbf5;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #1f7a4d;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.matched-name { font-weight: 600; }
.matched-dist { color: #07c160; font-weight: 600; }

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  background: none;
  border-radius: 50%;
  overflow: hidden;
}
.avatar-btn::after { border: none; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #f0f1f3; }

.certify-tip { font-size: 22rpx; color: #b0b3b8; margin-top: 16rpx; }

.submit-wrap { padding: 20rpx 0; }
.skip {
  text-align: center;
  color: #07c160;
  font-size: 26rpx;
  padding: 24rpx 0;
}
.btn-skip {
  margin-top: 20rpx;
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 84rpx;
}
.btn-skip::after { border: none; }
