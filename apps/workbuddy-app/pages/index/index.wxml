<view class="page">
  <!-- 顶部搜索 -->
  <view class="search-bar" bindtap="goSearch">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <text class="search-ph">搜索邻居发布的闲置好物</text>
    </view>
  </view>

  <!-- 分类导航 -->
  <scroll-view class="cate-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cate-item {{activeCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="changeCategory"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 商品列表 -->
  <view class="goods-grid" wx:if="{{list.length > 0}}">
    <view
      class="goods-card"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <image class="goods-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="goods-body">
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-price-row">
          <text class="price">{{item.priceText}}</text>
          <text class="tag" wx:if="{{item.conditionName}}">{{item.conditionName}}</text>
        </view>
        <view class="goods-meta">
          <text class="meta-comm">{{item.seller.communityName || '附近邻居'}}</text>
          <text class="meta-time">{{item.distanceText || item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-line">暂时没有闲置物品</text>
    <text class="empty-line">去发布第一个吧</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{list.length > 0}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">— 已经到底啦 —</text>
  </view>

  <!-- 悬浮发布按钮 -->
  <view class="fab" bindtap="goPublish">＋</view>
</view>
