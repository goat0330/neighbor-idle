/* pages/index/index.wxss */
.page { padding-bottom: 40rpx; }

/* 搜索条 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-box {
  background: #f2f3f5;
  border-radius: 36rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; }
.search-ph { color: #9aa0a6; font-size: 26rpx; }

/* 分类 */
.cate-bar {
  white-space: nowrap;
  background: #fff;
  padding: 8rpx 12rpx 16rpx;
  position: sticky;
  top: 100rpx;
  z-index: 9;
}
.cate-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: #555;
  background: #f2f3f5;
  border-radius: 32rpx;
}
.cate-item.active {
  color: #fff;
  background: #07c160;
  font-weight: 600;
}

/* 商品流 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx;
  justify-content: space-between;
}
.goods-card {
  width: 344rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.goods-img {
  width: 100%;
  height: 344rpx;
  background: #f0f1f3;
}
.goods-body { padding: 16rpx; }
.goods-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  height: 78rpx;
}
.goods-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.goods-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}
.meta-comm { max-width: 200rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 加载更多 */
.load-more {
  text-align: center;
  color: #b0b3b8;
  font-size: 24rpx;
  padding: 24rpx 0 60rpx;
}

/* 悬浮发布 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 96rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 99;
}
