/* pages/editItem/editItem.wxss */
.page { padding-bottom: 60rpx; }

.section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.required { color: #ff4d2e; }
.count { font-size: 24rpx; color: #9aa0a6; font-weight: 400; margin-left: 8rpx; }

.img-grid { display: flex; flex-wrap: wrap; }
.img-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  margin: 0 16rpx 16rpx 0;
}
.img-item image { width: 100%; height: 100%; }
.img-del {
  position: absolute;
  top: 0; right: 0;
  width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 32rpx;
  border-radius: 0 0 0 12rpx;
}
.img-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #c8ccd1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9aa0a6;
}
.add-icon { font-size: 56rpx; line-height: 1; }
.add-text { font-size: 22rpx; margin-top: 8rpx; }

.form-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}
.form-item:last-child { border-bottom: none; }
.label { width: 170rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.input { flex: 1; font-size: 28rpx; }
.textarea { flex: 1; font-size: 28rpx; min-height: 100rpx; line-height: 1.6; }
.picker-value { flex: 1; font-size: 28rpx; }
.price-wrap { flex: 1; display: flex; align-items: center; }
.rmb { font-size: 32rpx; font-weight: 700; margin-right: 8rpx; }
.switch-item .label { flex: 1; }

.submit-wrap { padding: 20rpx 24rpx; }
