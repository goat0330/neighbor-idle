<view class="page">
  <view class="list" wx:if="{{list.length > 0}}">
    <view class="row" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDetail">
      <image class="row-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="row-main">
        <view class="row-title">{{item.title}}</view>
        <view class="row-tags">
          <text class="price">{{item.priceText}}</text>
          <text class="tag {{item.status === 'on_sale' ? '' : 'tag-gray'}}">{{item.statusText}}</text>
          <text class="row-time">{{item.timeText}}</text>
        </view>
      </view>
      <view class="op-btn" data-index="{{index}}" catchtap="operate">···</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-line">还没有发布过闲置</text>
    <text class="empty-line">点击下方按钮发布第一件</text>
    <button class="btn-primary empty-btn" bindtap="goPublish">去发布</button>
  </view>
</view>
