/* pages/want/want.wxss */
.page { padding-bottom: 40rpx; }

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
}
.top-left { color: #555; font-size: 28rpx; }
.top-right {
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
}

.cate-bar {
  white-space: nowrap;
  background: #fff;
  padding: 8rpx 12rpx 20rpx;
}
.cate-item {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: #555;
  background: #f2f3f5;
  border-radius: 32rpx;
}
.cate-item.active { color: #fff; background: #07c160; font-weight: 600; }

.want-list { padding: 16rpx 24rpx; }
.want-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.want-head { display: flex; align-items: center; justify-content: space-between; }
.want-title { font-size: 30rpx; font-weight: 600; color: #222; flex: 1; margin-right: 12rpx; }
.want-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.want-price {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff8f1f;
  background: #fff4e6;
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.want-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.load-more { text-align: center; color: #b0b3b8; font-size: 24rpx; padding: 24rpx 0; }

/* 弹窗 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.want-dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}
.dialog-title { font-size: 34rpx; font-weight: 700; margin-bottom: 20rpx; }
.dialog-row { font-size: 27rpx; color: #444; margin-top: 12rpx; }
.dialog-desc {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #666;
  line-height: 1.6;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
}
.dialog-phone {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #07c160;
  padding: 16rpx 0;
  text-align: center;
  background: #f0f9f4;
  border-radius: 12rpx;
}
.dialog-tip { margin-top: 16rpx; font-size: 22rpx; color: #9aa0a6; text-align: center; }
.dialog-btn {
  margin-top: 28rpx;
  background: #07c160;
  color: #fff;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
}
