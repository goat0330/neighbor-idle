<view class="page">
  <view class="list" wx:if="{{list.length > 0}}">
    <view class="row" wx:for="{{list}}" wx:key="_id">
      <view class="row-main">
        <view class="row-title">{{item.title}}</view>
        <view class="row-tags">
          <text class="tag">{{item.categoryName}}</text>
          <text class="tag {{item.status === 'open' ? '' : 'tag-gray'}}">{{item.status === 'open' ? '进行中' : '已关闭'}}</text>
          <text class="row-time">{{item.timeText}}</text>
        </view>
        <view class="row-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
      </view>
      <view class="op-btn" wx:if="{{item.status === 'open'}}" data-id="{{item._id}}" catchtap="closeWant">关闭</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-icon">🛒</text>
    <text class="empty-line">还没有发布过求购</text>
    <text class="empty-line">发布你的第一条求购需求吧</text>
    <button class="btn-primary empty-btn" bindtap="goPublishWant">发布求购</button>
  </view>
</view>
